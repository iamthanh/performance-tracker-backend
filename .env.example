# Copy to $FITNESS_HUB_HOME/.env (default ~/.fitness-hub/.env) or ./.env.
# Real environment variables take precedence over both files.

# Where the database, tokens.json and garmin-tokens/ live.
# FITNESS_HUB_HOME=~/.fitness-hub

# Strava API application (https://www.strava.com/settings/api).
# Authorization Callback Domain must be: localhost
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Google Cloud OAuth client of type "Web application" with the authorized
# redirect URI http://localhost:8765/callback and the Google Health API enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: only used to skip the prompts during `fitness-hub auth garmin`.
# The password is never written to disk by fitness-hub.
# GARMIN_EMAIL=
# GARMIN_PASSWORD=

# Local OAuth redirect port (must match the registered redirect URI).
# OAUTH_PORT=8765

# History fetched on the first sync of each stream, in days.
# BACKFILL_DAYS=365

# Overlap re-fetched on every incremental sync, in days.
# LOOKBACK_DAYS=7
